{
  "name": "upsy-platform",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "predev": "npx tsx scripts/generate-sitemap.ts",
    "prebuild": "npx tsx scripts/generate-sitemap.ts",
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "sitemap": "npx tsx scripts/generate-sitemap.ts",
    "test:visual": "npx tsx tests/visual/run.ts",
    "lint": "eslint .",
    "check:runtime": "node scripts/check-runtime.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:env": "node scripts/check-env-safety.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:build": "node scripts/verify-build.mjs",
    "check:supabase": "node scripts/check-supabase-sync.mjs",
    "check:database": "node scripts/check-database.mjs",
    "check:vercel": "node scripts/check-vercel-config.mjs",
    "check:production": "node scripts/check-production.mjs",
    "test:audit": "node tests/audit/run.mjs",
    "verify": "npm run check:runtime && npm run check:env && npm run check:deploy && npm run check:supabase && npm run typecheck && npm run test && npm run build && npm run check:bundle && npm run check:build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "deploy": "npm run build && npx wrangler deploy --config dist/server/wrangler.json",
    "deploy:preview": "npm run build && npx wrangler versions upload --config dist/server/wrangler.json",
    "preview:cf": "npm run build && npx wrangler dev --config dist/server/wrangler.json",
    "check:deploy": "node scripts/check-deploy-config.mjs"
  },
  "overrides": {
    "rolldown": "1.2.1"
  },
