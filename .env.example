# UPSY — environment contract
#
# Copy to `.env` for local work, and set the same keys in the hosting provider
# (Cloudflare Workers secrets / Vercel project env) before any cutover.
# `VITE_*` values are inlined into the browser bundle: publishable only.
# Everything else is server-side and must never be prefixed with VITE_.

# --- Backend (required) -----------------------------------------------------
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-or-publishable-key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# Server-side mirrors, read inside server functions / scripts.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<anon-or-publishable-key>
# Bypasses RLS. Never expose to the client, never commit.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Site identity (required in production) ---------------------------------
# Canonical origin. Drives sitemap, canonicals and OAuth redirect building.
VITE_SITE_URL=https://www.upsy.ma

# --- Optional -----------------------------------------------------------------
VITE_APP_VERSION=
VITE_OAUTH_PROVIDERS=google,apple
# Google Maps/Places JS key. VITE_-prefixed and inlined client-side on purpose —
# these keys are meant to be public, secured by HTTP referrer restriction in
# Cloud Console (restrict to https://www.upsy.ma/*), not by secrecy. Unset
# until a feature actually calls the Maps/Places JS API; see DEPLOYMENT.md
# § Google Maps for the console steps and the CSP entries a consumer will need.
VITE_GOOGLE_MAPS_API_KEY=
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# GTM's container ID is a plain constant in src/routes/__root.tsx, not an
# env var — it's not a secret (visible in every page's source).

# --- Edge function secrets (set on the backend, not the host) ----------------
# RESEND_API_KEY, LOVABLE_API_KEY, CRON_SECRET, NOTE_ENCRYPTION_KEY
# See docs/runbooks/00-exit-and-ownership.md § C.6.

# --- CI / deploy (GitHub Actions secrets, not .env) --------------------------
# CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID
